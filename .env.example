# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens (JWT) for authentication.
JWT_SECRET="smartcursos-secure-jwt-secret-key-change-in-production"

# SMTP Email Configuration for real email sending (Gmail, Brevo, SendGrid, etc.)
# For Gmail: SMTP_HOST="smtp.gmail.com", SMTP_PORT="587", SMTP_USER="your-email@gmail.com", SMTP_PASS="16-character-app-password"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Alternative: Resend API Key for sending emails via Resend
RESEND_API_KEY=
RESEND_FROM=

# Supabase Configuration & PostgreSQL Connection (Recommended for Production & Vercel)
# Obtain these from your Supabase project dashboard (Settings > Database and API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-public-key"
# SUPABASE_SERVICE_ROLE_KEY: CRITICAL - Keep secret, never expose to frontend/browser!
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"

# Supabase PostgreSQL Database URL (Connection String / Transaction Pooler via Supavisor)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SUPABASE_DATABASE_URL=
SUPABASE_DB_URL=
DATABASE_URL=
POSTGRES_URL=

# Optional individual Supabase / PostgreSQL host parameters
SUPABASE_HOST=
SUPABASE_PORT=5432
SUPABASE_USER=postgres
SUPABASE_PASSWORD=
SUPABASE_DB_NAME=postgres

# Google Cloud SQL (PostgreSQL) - Injected when running in Google Cloud runtime
SQL_HOST=
SQL_PORT=
SQL_USER=
SQL_PASSWORD=
SQL_ADMIN_USER=
SQL_ADMIN_PASSWORD=
SQL_DB_NAME=

